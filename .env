# =============================================================================
# Cloud Security gRPC Simulator - Environment Configuration
# =============================================================================
# WARNING: Never commit this file to version control!
# Copy this to .env and fill in your actual values.
# =============================================================================

# -----------------------------------------------------------------------------
# SMTP Email Configuration (Gmail)
# -----------------------------------------------------------------------------
# Your Gmail address for sending OTP emails
SMTP_EMAIL=sasbergson@gmail.com

# Gmail App Password (NOT your regular Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_APP_PASSWORD=tgnw azxw lfjr jsuz

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
GRPC_SERVER_HOST=[::]
GRPC_SERVER_PORT=51234
GRPC_MAX_WORKERS=10

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# OTP validity duration in minutes
OTP_EXPIRY_MINUTES=5

# JWT Secret Key - Used for signing tokens
# IMPORTANT: Use a different key in production!
JWT_SECRET=84f8cef7fe629f055124a0afbbf56c28a827fa5151910fde43c4794785302789

# JWT token expiry in minutes (access token)
JWT_ACCESS_EXPIRY_MINUTES=15

# JWT refresh token expiry in minutes (7 days)
JWT_REFRESH_EXPIRY_MINUTES=10080

# Rate Limiting - Maximum failed login attempts before account lockout
MAX_LOGIN_ATTEMPTS=5

# Account lockout duration in minutes after max failed attempts
LOCKOUT_DURATION_MINUTES=15

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DATABASE_PATH=cloudsecurity.db

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

